# Telegram (majburiy)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Claude auth — IKKISIDAN BITTASI yetarli:
# 1) Obunangizdan token: `claude setup-token` buyrug'i beradi
CLAUDE_CODE_OAUTH_TOKEN=
# 2) Yoki API key (console.anthropic.com)
# ANTHROPIC_API_KEY=

# Ixtiyoriy
CLAUDE_MODEL=claude-sonnet-4-6
MAX_CLAUDE_CALLS_PER_DAY=40
# Railway'da volume ulang va: DB_PATH=/data/journal.db

# ─── Binance jonli savdo (ixtiyoriy) ───
# Bo'sh qoldirsangiz bot faqat signal beradi, savdo qilmaydi.
# API key'ni FAQAT Spot Trading ruxsati bilan yarating, Withdrawal'ni O'CHIRING.
# DIQQAT: api.binance.com Railway US IP'dan bloklangan (451) — savdoni
# Binance'ga ulanadigan joydan (Mac yoki Uzbekistan VPS) ishga tushiring.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# semi = har savdodan oldin Telegram tugmasi bilan tasdiq; auto = avtomatik; off = savdo yo'q
TRADING_MODE=semi
RISK_PER_TRADE=0.01      # depozitning 1%
MAX_TRADE_QUOTE=100      # bitta pozitsiya uchun maksimal USDT
DAILY_LOSS_STOP_R=-3     # kunlik -3R ga yetganda savdo to'xtaydi

# Telegram (majburiy)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Claude auth — IKKISIDAN BITTASI yetarli:
# 1) Obunangizdan token: `claude setup-token` buyrug'i beradi
CLAUDE_CODE_OAUTH_TOKEN=
# 2) Yoki API key (console.anthropic.com)
# ANTHROPIC_API_KEY=

# Ixtiyoriy
CLAUDE_MODEL=claude-sonnet-4-6
MAX_CLAUDE_CALLS_PER_DAY=40
# Railway'da volume ulang va: DB_PATH=/data/journal.db

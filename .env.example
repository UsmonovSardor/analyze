# ─── Telegram (majburiy) ───
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ─── AI provayder ───
# grok = xAI Grok (asosiy, real-time X/yangiliklardan xabardor)
# gemini = Google Gemini (zaxira)
AI_PROVIDER=grok

# ─── Grok / xAI (asosiy, majburiy) ───
# https://console.x.ai dan olinadi
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL_FINAL=grok-4           # yakuniy qaror qabul qiladigan kuchli model
GROK_MODEL=grok-3-mini            # tez/arzon zaxira model
GROK_TEMPERATURE=0.2             # past = barqaror, aniq javob

# ─── Gemini AI (zaxira, ixtiyoriy) ───
# Google AI Studio'dan bepul olinadi: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_CLAUDE_CALLS_PER_DAY=150      # kunlik AI tahlil byudjeti

# ─── Signal sozlamalari ───
MIN_SCORE=6                       # minimal ishonch (6 = ko'proq signal, 7 = kamroq/sifatli)
ALLOW_SHORTS=true                 # 🔻 SHORT signallarini yoqish
TARGET_SIGNALS_PER_DAY=10
# Railway'da volume ulang va: DB_PATH=/data/journal.db

# ─── Binance jonli savdo (ixtiyoriy) ───
# Bo'sh qoldirsangiz bot faqat signal beradi, savdo qilmaydi.
# Futures uchun API key'da "Enable Futures" yoqing, Withdrawal'ni O'CHIRING.
# DIQQAT: Binance ba'zi serverlardan 451 bilan bloklangan — savdoni
# Binance'ga ulanadigan serverdan (Hetzner EU) ishga tushiring.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MARKET=future            # future = long+short (plecho); spot = faqat long
LEVERAGE=3                       # futures plecho (past tuting)
# semi = har savdodan oldin Telegram tugmasi bilan tasdiq; auto = avtomatik; off = savdo yo'q
TRADING_MODE=semi
RISK_PER_TRADE=0.01              # depozitning 1%
MAX_TRADE_QUOTE=100             # bitta pozitsiya uchun maksimal margin (USDT)
DAILY_LOSS_STOP_R=-3            # kunlik -3R ga yetganda savdo to'xtaydi

# ─── Screener ───
# TradingView screener (crypto + forex + oltin + aksiya). true tavsiya etiladi.
USE_TV_SCREENER=true

# ─── TradingView Pine Script webhook (ixtiyoriy) ───
# TradingView Pro+ kerak; server IP:8080 portini oching
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8080
WEBHOOK_SECRET=                  # tasodifiy kalit: openssl rand -hex 16
